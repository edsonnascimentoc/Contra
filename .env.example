# Copy to .env for local development. Keep real values out of source control.
PORT=3001
NODE_ENV=development

# Required: generate locally with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Required: PostgreSQL URL matching prisma/schema.prisma.
DATABASE_URL=

# Optional comma-separated exact origins. Production must set its frontend origins explicitly.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional rate limits (defaults: 15 minutes, 100 global requests and 60 per operational route).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OPERATIONAL_RATE_LIMIT_WINDOW_MS=900000
OPERATIONAL_RATE_LIMIT_MAX_REQUESTS=60
